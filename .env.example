# Copy to .env.local for local dev. On Vercel, set these under Project > Settings > Environment Variables.

# Spot prices for the Sell page (https://metalpriceapi.com, free plan: daily prices).
METALPRICE_API_KEY=

# Optional fallback when the API key is missing or the API is down: spot prices in USD per troy oz.
SPOT_SILVER_USD=
SPOT_GOLD_USD=

# Sell form emails (https://resend.com). FROM must use a domain verified in Resend;
# onboarding@resend.dev only delivers to the Resend account owner's own address.
RESEND_API_KEY=
SELL_EMAIL_TO=
SELL_EMAIL_FROM="Silver Sphinx <offers@silversphinxnyc.com>"
